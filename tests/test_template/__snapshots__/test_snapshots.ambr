# serializer version: 1
# name: test_generated_structured_file_snapshots
  dict({
    'act_workflow': dict({
      'jobs': dict({
        'act-validation': dict({
          'env': dict({
            'ACT_VERSION': 'v0.2.89',
            'CARGO_TERM_COLOR': 'always',
          }),
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Install mdtablefix',
              'uses': 'leynos/shared-actions/.github/actions/install-mdtablefix@<sha>',
              'with': dict({
                'version': '0.6.0',
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'rustflags': '',
              }),
            }),
            dict({
              'name': 'Install linker prerequisites',
              'run': '''
                set -euo pipefail
                export DEBIAN_FRONTEND=noninteractive
                sudo apt-get update \
                  && sudo apt-get install --yes --no-install-recommends clang mold
  
              ''',
            }),
            dict({
              'name': 'Install the build standard',
              'run': 'make install-build-tools',
            }),
            dict({
              'name': 'Install act',
              'run': '''
                curl -fsSL "https://github.com/nektos/act/releases/download/${ACT_VERSION}/act_Linux_x86_64.tar.gz" |
                  sudo tar -xz -C /usr/local/bin act
  
              ''',
            }),
            dict({
              'name': 'Check Docker runtime',
              'run': 'docker info',
            }),
            dict({
              'env': dict({
                'GITHUB_TOKEN': '${{ github.token }}',
              }),
              'name': 'Run tests with act validation',
              'run': 'make test WITH_ACT=1',
            }),
          ]),
        }),
      }),
      'name': 'Act Validation',
      'on': dict({
        'workflow_dispatch': None,
      }),
    }),
    'audit_workflow': dict({
      'jobs': dict({
        'audit': dict({
          'env': dict({
            'CARGO_TERM_COLOR': 'always',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'name': 'Install cargo-audit',
              'run': 'cargo binstall --no-confirm cargo-audit',
            }),
            dict({
              'name': 'Setup Python for audit manifest extraction',
              'uses': 'actions/setup-python@<sha>',
              'with': dict({
                'python-version': '3.x',
              }),
            }),
            dict({
              'name': 'Audit dependencies',
              'run': 'make audit',
            }),
          ]),
          'timeout-minutes': 30,
        }),
      }),
      'name': 'Scheduled dependency audit',
      'on': dict({
        'schedule': list([
          dict({
            'cron': '41 6 * * 1',
          }),
        ]),
        'workflow_dispatch': None,
      }),
      'permissions': dict({
        'contents': 'read',
      }),
    }),
    'cargo_config': '''
      # Cargo selects one rustflags source; target flags replace build flags.
      # Make development gates repeat these defaults when assigning RUSTFLAGS.
      [unstable]
      codegen-backend = true
      
      [profile.dev]
      codegen-backend = "cranelift"
      
      [build]
      rustflags = ["-Zthreads=8", "-Zpolonius=next"]
      rustdocflags = ["-Zpolonius=next"]
      
      # Only native x86_64 GNU Linux has a verified mold route.
      [target.x86_64-unknown-linux-gnu]
      linker = "scripts/native-clang-linker.sh"
      rustflags = ["-Zthreads=8", "-Zpolonius=next", "-C", "link-arg=-fuse-ld=mold"]
  
    ''',
    'ci_workflow': dict({
      'jobs': dict({
        'build-test': dict({
          'env': dict({
            'BUILD_PROFILE': 'debug',
            'CARGO_TERM_COLOR': 'always',
          }),
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'rustflags': '',
              }),
            }),
            dict({
              'name': 'Log Rust compiler configuration',
              'run': '''
                rustc --version
                printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
              ''',
            }),
            dict({
              'if': "runner.os == 'Linux'",
              'name': 'Install linker prerequisites',
              'run': '''
                set -euo pipefail
                export DEBIAN_FRONTEND=noninteractive
                sudo apt-get update \
                  && sudo apt-get install --yes --no-install-recommends clang lld mold
  
              ''',
            }),
            dict({
              'name': 'Install the build standard',
              'run': 'make install-build-tools',
            }),
            dict({
              'name': 'Install mdtablefix',
              'uses': 'leynos/shared-actions/.github/actions/install-mdtablefix@<sha>',
              'with': dict({
                'version': '0.6.0',
              }),
            }),
            dict({
              'name': 'Format',
              'run': 'make check-fmt',
            }),
            dict({
              'name': 'Markdown lint',
              'uses': 'DavidAnson/markdownlint-cli2-action@<sha>',
              'with': dict({
                'globs': '**/*.md',
              }),
            }),
            dict({
              'name': 'Setup uv',
              'uses': 'astral-sh/setup-uv@<sha>',
            }),
            dict({
              'name': 'Check spelling',
              'run': 'make spelling',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'name': 'Install test runner',
              'run': 'cargo binstall --no-confirm --locked cargo-nextest',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'if': "github.actor != 'dependabot[bot]'",
              'name': 'Install cargo-audit',
              'run': 'cargo binstall --no-confirm cargo-audit',
            }),
            dict({
              'if': "github.actor != 'dependabot[bot]'",
              'name': 'Setup Python for audit manifest extraction',
              'uses': 'actions/setup-python@<sha>',
              'with': dict({
                'python-version': '3.x',
              }),
            }),
            dict({
              'name': 'Install Whitaker',
              'uses': 'leynos/shared-actions/.github/actions/install-whitaker@<sha>',
              'with': dict({
                'cranelift': 'true',
              }),
            }),
            dict({
              'if': "github.actor != 'dependabot[bot]'",
              'name': 'Audit dependencies',
              'run': 'make audit',
            }),
            dict({
              'env': dict({
                'DYLINT_DRIVER_PATH': '${{ runner.temp }}/generated-whitaker-driver',
              }),
              'name': 'Lint',
              'run': '''
                mkdir -p "$DYLINT_DRIVER_PATH"
                make lint
  
              ''',
            }),
            dict({
              'name': 'Log coverage linker configuration',
              'run': '''
                echo "Coverage linker: clang"
                echo "Coverage RUSTFLAGS: -D warnings -Zpolonius=next -C link-arg=-fuse-ld=lld"
                echo "Coverage CFLAGS: -fuse-ld=lld"
                echo "Coverage LDFLAGS: -fuse-ld=lld"
  
              ''',
            }),
            dict({
              'env': dict({
                'CARGO_PROFILE_DEV_CODEGEN_BACKEND': 'llvm',
                'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER': 'clang',
                'CFLAGS': '-fuse-ld=lld',
                'LDFLAGS': '-fuse-ld=lld',
                'RUSTFLAGS': '-D warnings -Zpolonius=next -C link-arg=-fuse-ld=lld',
              }),
              'if': "env.ACT != 'true'",
              'name': 'Test and Measure Coverage',
              'uses': 'leynos/shared-actions/.github/actions/generate-coverage@<sha>',
              'with': dict({
                'format': 'lcov',
                'output-path': 'lcov.info',
                'publish-artefact': 'false',
                'with-ratchet': 'true',
              }),
            }),
            dict({
              'env': dict({
                'WITH_ACT': '0',
              }),
              'if': "env.ACT == 'true'",
              'name': 'Test under Act',
              'run': 'make test',
            }),
          ]),
        }),
      }),
      'name': 'CI',
      'on': dict({
        'pull_request': dict({
          'types': list([
            'opened',
            'synchronize',
            'reopened',
          ]),
        }),
        'workflow_dispatch': None,
      }),
    }),
    'coverage_main_workflow': dict({
      'concurrency': dict({
        'cancel-in-progress': False,
        'group': 'coverage-main-${{ github.ref }}',
      }),
      'jobs': dict({
        'coverage-upload': dict({
          'env': dict({
            'BUILD_PROFILE': 'debug',
            'CARGO_TERM_COLOR': 'always',
          }),
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'rustflags': '',
              }),
            }),
            dict({
              'name': 'Log Rust compiler configuration',
              'run': '''
                rustc --version
                printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
              ''',
            }),
            dict({
              'if': "runner.os == 'Linux'",
              'name': 'Install linker prerequisites',
              'run': '''
                set -euo pipefail
                export DEBIAN_FRONTEND=noninteractive
                # mold accelerates dev builds; coverage uses lld for llvm-tools compatibility.
                sudo apt-get update \
                  && sudo apt-get install --yes --no-install-recommends clang lld mold
  
              ''',
            }),
            dict({
              'name': 'Install the build standard',
              'run': 'make install-build-tools',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'name': 'Install test runner',
              'run': 'cargo binstall --no-confirm --locked cargo-nextest',
            }),
            dict({
              'name': 'Log coverage linker configuration',
              'run': '''
                echo "Coverage linker: clang"
                echo "Coverage RUSTFLAGS: -D warnings -Zpolonius=next -C link-arg=-fuse-ld=lld"
                echo "Coverage CFLAGS: -fuse-ld=lld"
                echo "Coverage LDFLAGS: -fuse-ld=lld"
  
              ''',
            }),
            dict({
              'env': dict({
                'CARGO_PROFILE_DEV_CODEGEN_BACKEND': 'llvm',
                'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER': 'clang',
                'CFLAGS': '-fuse-ld=lld',
                'LDFLAGS': '-fuse-ld=lld',
                'RUSTFLAGS': '-D warnings -Zpolonius=next -C link-arg=-fuse-ld=lld',
              }),
              'name': 'Test and Measure Coverage',
              'uses': 'leynos/shared-actions/.github/actions/generate-coverage@<sha>',
              'with': dict({
                'format': 'lcov',
                'output-path': 'lcov.info',
                'with-ratchet': 'true',
              }),
            }),
            dict({
              'id': 'codescene_token',
              'name': 'Check CodeScene token availability',
              'run': 'echo "available=${{ secrets.CS_ACCESS_TOKEN != \'\' }}" >> "$GITHUB_OUTPUT"',
            }),
            dict({
              'if': "steps.codescene_token.outputs.available == 'true' && github.ref == 'refs/heads/main'",
              'name': 'Upload coverage data to CodeScene',
              'uses': 'leynos/shared-actions/.github/actions/upload-codescene-coverage@<sha>',
              'with': dict({
                'access-token': '${{ secrets.CS_ACCESS_TOKEN }}',
                'format': 'lcov',
                'mode': 'upload',
              }),
            }),
          ]),
        }),
      }),
      'name': 'Coverage (main)',
      'on': dict({
        'push': dict({
          'branches': list([
            'main',
          ]),
        }),
        'workflow_dispatch': None,
      }),
    }),
    'makefile': '''
      # `make fmt` and `make check-fmt` call mdtablefix directly. `--git` selects the
      # Markdown files Git tracks and `--include-untracked` adds the untracked files
      # Git does not ignore, so a new document is formatted before it is staged.
      # Both modes need mdtablefix 0.6.0 or later; CI pins the version at its
      # install-mdtablefix step.
      MDTABLEFIX ?= mdtablefix
      MDTABLEFIX_SELECT = --git --include-untracked
      MDTABLEFIX_RULES = --wrap --renumber --breaks --ellipsis --fences
      
      .PHONY: help all clean test act-validation whitaker-driver-integration build release package coverage \
        lint lint-clippy lint-whitaker fmt check-fmt markdownlint spelling nixie \
        typecheck audit rust-audit install-build-tools check-build-tools check-coverage-tools
      
      SHELL := bash
      
      
      
      TARGET ?= snapshot_example
      
      
      USER_WHITAKER := $(HOME)/.local/bin/whitaker
      USER_BIN_PATH := $(HOME)/.cargo/bin:$(HOME)/.local/bin:$(HOME)/.bun/bin
      CARGO ?= cargo
      BUILD_JOBS ?=
      BUILD_TOOLS_PREFIX ?= $(HOME)/.local
      CHECK_BUILD_TOOLS ?= scripts/check-build-tools.sh
      export BUILD_TOOLS_PREFIX
      export PATH := $(BUILD_TOOLS_PREFIX)/bin:$(PATH)
      POLONIUS_FLAGS ?= -Zpolonius=next
      RUST_FLAGS ?=
      RUST_FLAGS := -D warnings $(RUST_FLAGS)
      # The build standard: every `rustflags` source in `.cargo/config.toml` carries
      # the parallel frontend, and the x86_64 GNU Linux source adds `mold`. Assigning `RUSTFLAGS`
      # replaces those sources outright, so the gate targets restate the flags here.
      # Development recipes add those flags to inherited RUSTFLAGS, including the CI
      # setup-rust value. Coverage, release, and packaging take neither. The checked toolchain
      # components come from rust-toolchain.toml. Native Cargo routes through the
      # Clang wrapper, which puts pinned ld.mold first; coverage checks its lld linker.
      DEV_THREADS_FLAGS ?= -Zthreads=8
      BUILD_HOST_OS := $(shell uname -s)
      # Only the native x86_64 GNU Linux route has a pinned mold linker.
      BUILD_HOST_ARCH := $(shell uname -m)
      BUILD_HOST_TRIPLE := $(shell rustup show 2>/dev/null | sed -n 's/^Default host: //p')
      DEV_LINKER_FLAGS ?= $(if $(and $(filter Linux,$(BUILD_HOST_OS)),$(filter x86_64,$(BUILD_HOST_ARCH)),$(filter x86_64-unknown-linux-gnu,$(BUILD_HOST_TRIPLE))),-C link-arg=-fuse-ld=mold)
      DEV_RUST_FLAGS ?= $(RUST_FLAGS) $(POLONIUS_FLAGS) $(DEV_THREADS_FLAGS) $(DEV_LINKER_FLAGS)
      RELEASE_RUST_FLAGS ?= $(RUST_FLAGS) $(POLONIUS_FLAGS)
      PACKAGE_FLAGS ?=
      RUSTDOC_FLAGS ?=
      RUSTDOC_FLAGS := --cfg docsrs -D warnings $(POLONIUS_FLAGS) $(RUSTDOC_FLAGS)
      CARGO_FLAGS ?= --all-targets --all-features
      CLIPPY_FLAGS ?= $(CARGO_FLAGS) -- $(RUST_FLAGS)
      TEST_FLAGS ?= $(CARGO_FLAGS)
      TEST_CMD := $(if $(shell $(CARGO) nextest --version 2>/dev/null),nextest run,test)
      WITH_ACT ?= 0
      ACT ?= act
      ACT_RUNNER_IMAGE ?= catthehacker/ubuntu:act-latest
      ACT_GIT_COMMON_DIR := $(shell git rev-parse --path-format=absolute --git-common-dir)
      ACT_GITHUB_TOKEN ?= $(or $(GITHUB_TOKEN),$(GH_TOKEN))
      COVERAGE_LINKER_FLAGS ?= -fuse-ld=lld
      COVERAGE_RUST_FLAGS ?= $(RUST_FLAGS) $(POLONIUS_FLAGS) -C link-arg=$(COVERAGE_LINKER_FLAGS)
      # RUSTFLAGS displaces configured flags, while the dev profile backend needs its
      # own override so coverage runs LLVM instrumentation instead of Cranelift.
      MDLINT ?= markdownlint-cli2
      NIXIE ?= nixie
      TYPOS_CONFIG_BUILDER_VERSION ?= v0.1.3
      TYPOS_CONFIG_BUILDER = uv tool run --from \
      \t"git+https://github.com/leynos/typos-config-builder.git@$(TYPOS_CONFIG_BUILDER_VERSION)" \
      \ttypos-config-builder
      WHITAKER ?= $(or $(shell command -v whitaker 2>/dev/null),$(wildcard $(USER_WHITAKER)),whitaker)
      
      build: target/debug/$(TARGET) ## Build debug binary
      release: ## Build the production release artefact with LLVM and the platform linker
      \t$(PRODUCTION_ENV) $(CARGO) build $(BUILD_JOBS) --release
      
      package: ## Build and verify a publishable Cargo package with LLVM
      \t$(PRODUCTION_ENV) $(CARGO) package --locked $(PACKAGE_FLAGS)
      
      all: ## Perform every commit gate sequentially, even with make -j
      \t+$(MAKE) check-fmt
      \t+$(MAKE) lint
      \t+$(MAKE) test
      \t+$(MAKE) spelling
      
      clean: ## Remove build artefacts
      \t$(CARGO) clean
      \trm -f .typos-oxendict-base.json .typos-oxendict-base.toml
      
      test: check-build-tools ## Run tests with warnings treated as errors
      \tRUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }$(DEV_RUST_FLAGS)" $(CARGO) $(TEST_CMD) $(TEST_FLAGS) $(BUILD_JOBS)
      \tRUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }$(DEV_RUST_FLAGS)" RUSTDOCFLAGS="$(RUSTDOC_FLAGS)" $(CARGO) test --doc --workspace --all-features
      \tif [ "$(WITH_ACT)" = "1" ]; then $(MAKE) act-validation; fi
      
      act-validation: ## Run the CI workflow through Act after outer Cargo tests pass
      \t@GITHUB_TOKEN="$(ACT_GITHUB_TOKEN)" $(ACT) pull_request --bind \
      \t\t--container-options "--volume $(ACT_GIT_COMMON_DIR):$(ACT_GIT_COMMON_DIR):ro" \
      \t\t--secret GITHUB_TOKEN \
      \t\t--env ACT=true \
      \t\t--platform "ubuntu-latest=$(ACT_RUNNER_IMAGE)" \
      \t\t--workflows .github/workflows/ci.yml --job build-test
      
      whitaker-driver-integration: ## Check cold then warm Dylint driver construction
      \t@set -euo pipefail; mkdir -p target; \
      \t\tcache_dir="$$(mktemp -d "$(CURDIR)/target/whitaker-driver.XXXXXX")"; \
      \t\ttrap 'rm -rf "$$cache_dir"' EXIT; \
      \t\tDYLINT_DRIVER_PATH="$$cache_dir" $(MAKE) lint-whitaker; \
      \t\tDYLINT_DRIVER_PATH="$$cache_dir" $(MAKE) lint-whitaker
      
      target/debug/$(TARGET): check-build-tools ## Build debug binary
      \tRUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }$(DEV_RUST_FLAGS)" $(CARGO) build $(BUILD_JOBS)
      
      # Cargo packages the repository config and verifies with the dev profile. Both
      # profiles therefore select LLVM; the native linker override bypasses the
      # development wrapper even for release host/build-script units. An inherited
      # encoded flags value would outrank RUSTFLAGS, so remove it explicitly.
      PRODUCTION_ENV = env -u CARGO_ENCODED_RUSTFLAGS CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang CARGO_PROFILE_DEV_CODEGEN_BACKEND=llvm CARGO_PROFILE_RELEASE_CODEGEN_BACKEND=llvm RUSTFLAGS="$(RELEASE_RUST_FLAGS)"
      
      coverage: check-coverage-tools ## Generate lcov coverage with lld for llvm-tools compatibility
      \t@echo "coverage linker flags: $(COVERAGE_LINKER_FLAGS)"
      \tCARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang \
      \t\tCARGO_PROFILE_DEV_CODEGEN_BACKEND=llvm \
      \t\tRUSTFLAGS="$(COVERAGE_RUST_FLAGS)" \
      \t\tCFLAGS="$(COVERAGE_LINKER_FLAGS)" \
      \t\tLDFLAGS="$(COVERAGE_LINKER_FLAGS)" \
      \t\t$(CARGO) llvm-cov --lcov --output-path lcov.info $(TEST_FLAGS)
      
      lint: ## Run rustdoc, Clippy, then Whitaker sequentially
      \t+$(MAKE) lint-clippy
      \t+$(MAKE) lint-whitaker
      
      lint-clippy: check-build-tools ## Run rustdoc and Clippy with warnings denied
      \tRUSTDOCFLAGS="$(RUSTDOC_FLAGS)" RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }$(DEV_RUST_FLAGS)" $(CARGO) doc --no-deps
      \tRUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }$(DEV_RUST_FLAGS)" $(CARGO) clippy $(CLIPPY_FLAGS)
      
      WHITAKER_CLEAN_ENV = env -u RUSTFLAGS -u CARGO_ENCODED_RUSTFLAGS \
      \t-u CARGO_PROFILE_DEV_CODEGEN_BACKEND -u CARGO_BUILD_TARGET \
      \t-u CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER \
      \t-u CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS -u CFLAGS -u LDFLAGS
      
      lint-whitaker: ## Run Whitaker with clean driver inputs and repository Cargo defaults
      \t@$(WHITAKER_CLEAN_ENV) $(CHECK_BUILD_TOOLS)
      \t@echo "Whitaker binary: $(WHITAKER)"
      \t$(WHITAKER_CLEAN_ENV) PATH="$(USER_BIN_PATH):$(PATH)" DYLINT_RUSTFLAGS="$(RUST_FLAGS) $(POLONIUS_FLAGS)" $(WHITAKER) --all -- $(CARGO_FLAGS)
      
      typecheck: check-build-tools ## Type-check without building
      \tRUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }$(DEV_RUST_FLAGS)" $(CARGO) check $(CARGO_FLAGS)
      
      install-build-tools: ## Install pinned `mold` and the repository toolchain
      \t@scripts/install-build-tools.sh
      
      check-build-tools: ## Check pinned development build prerequisites
      \t@case " $(CARGO_FLAGS) $(TEST_FLAGS) $(BUILD_JOBS) " in *" --target "*|*" --target="*) \
      \t\techo "build-tools: --target is outside the supported native Make build" >&2; exit 1;; \
      \tesac; $(CHECK_BUILD_TOOLS)
      
      check-coverage-tools: ## Check coverage linker prerequisites
      \t@case " $(CARGO_FLAGS) $(TEST_FLAGS) $(BUILD_JOBS) " in *" --target "*|*" --target="*) \
      \t\techo "build-tools: --target is outside the supported native Make coverage" >&2; exit 1;; \
      \tesac; $(CHECK_BUILD_TOOLS) --coverage
      
      fmt: ## Format Rust and Markdown sources
      \t$(CARGO) fmt --all
      \t$(MDTABLEFIX) --in-place $(MDTABLEFIX_SELECT) $(MDTABLEFIX_RULES)
      \t$(MDLINT) --fix "**/*.md"
      
      check-fmt: ## Verify formatting
      \t$(CARGO) fmt --all -- --check
      \t$(MDTABLEFIX) --check $(MDTABLEFIX_SELECT) $(MDTABLEFIX_RULES)
      
      markdownlint: ## Lint Markdown files
      \t$(MDLINT) '**/*.md'
      \t+$(MAKE) spelling
      spelling: ## Enforce en-GB-oxendict spelling in Markdown prose
      \t@if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
      \t\techo "make spelling needs a Git repository: the gate enumerates tracked files with git ls-files. Run: git init && git add -A" >&2; \
      \t\texit 1; \
      \tfi
      \t@if [ -z "$$(git ls-files)" ]; then \
      \t\techo "make spelling found no tracked files: the gate enumerates tracked files with git ls-files. Run: git add -A" >&2; \
      \t\texit 1; \
      \tfi
      \t$(TYPOS_CONFIG_BUILDER) gate --repository .
      
      nixie: ## Validate Mermaid diagrams
      \t$(NIXIE) --no-sandbox
      
      audit: rust-audit ## Audit dependencies for known vulnerabilities
      
      rust-audit: ## Audit the Rust workspace for known vulnerabilities
      \tset -eo pipefail; \
      \tmanifest_list=$$(mktemp); \
      \ttrap 'rm -f "$$manifest_list"' EXIT; \
      \tprintf "Audit metadata phase: deriving workspace manifests\n"; \
      \t$(CARGO) metadata --no-deps --format-version 1 | python3 -c 'import json, sys; metadata = json.load(sys.stdin); members = set(metadata["workspace_members"]); print(metadata["workspace_root"]); [print(package["manifest_path"]) for package in metadata["packages"] if package["id"] in members]' > "$$manifest_list"; \
      \tworkspace_root=$$(sed -n '1p' "$$manifest_list"); \
      \taudit_flags=(); \
      \tfor advisory in $$CARGO_AUDIT_IGNORES; do \
      \t\taudit_flags+=(--ignore "$$advisory"); \
      \tdone; \
      \tprintf "Auditing Rust workspace %s\n" "$$workspace_root"; \
      \tsed -n '2,$$p' "$$manifest_list" | while IFS= read -r manifest; do \
      \t\tmanifest_dir=$$(dirname "$$manifest"); \
      \t\tprintf "Workspace Rust manifest %s\n" "$$manifest_dir/Cargo.toml"; \
      \tdone; \
      \tprintf "Audit execution phase: running cargo audit\n"; \
      \tprintf "Audit failures may indicate RustSec advisories, cargo metadata errors, or documented ignores that need CARGO_AUDIT_IGNORES entries.\n"; \
      \t(cd "$$workspace_root" && $(CARGO) audit "$${audit_flags[@]}")
      
      help: ## Show available targets
      \t@grep -E '^[a-zA-Z_-]+:.*?##' $(MAKEFILE_LIST) | \
      \tawk 'BEGIN {FS=":"; printf "Available targets:\n"} {printf "  %-20s %s\n", $$1, $$2}'
  
    ''',
    'mutation_workflow': dict({
      'concurrency': dict({
        'cancel-in-progress': False,
        'group': 'mutation-testing-${{ github.ref }}',
      }),
      'jobs': dict({
        'mutation': dict({
          'permissions': dict({
            'contents': 'read',
            'id-token': 'write',
          }),
          'uses': 'leynos/shared-actions/.github/workflows/mutation-cargo.yml@<sha>',
          'with': dict({
            'extra-args': '--all-features',
            'setup-commands': '''
              export DEBIAN_FRONTEND=noninteractive
              sudo apt-get update \
                && sudo apt-get install --yes --no-install-recommends clang lld mold
              make install-build-tools
  
            ''',
          }),
        }),
      }),
      'name': 'Mutation testing',
      'on': dict({
        'schedule': list([
          dict({
            'cron': '15 9 * * *',
          }),
        ]),
        'workflow_dispatch': None,
      }),
      'permissions': dict({
      }),
    }),
    'release_workflow': dict({
      'env': dict({
        'BIN_NAME': 'snapshot_example',
        'CROSS_REVISION': '88f49ff79e777bef6d3564531636ee4d3cc2f8d2',
      }),
      'jobs': dict({
        'build': dict({
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'rustflags': '-D warnings -Zpolonius=next',
                'toolchain': 'nightly-2026-08-27',
              }),
            }),
            dict({
              'name': 'Log Rust compiler configuration',
              'run': '''
                rustc --version
                printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
              ''',
            }),
            dict({
              'id': 'cache-cross',
              'name': 'Cache cross binary',
              'uses': 'actions/cache@<sha>',
              'with': dict({
                'key': 'cross-${{ env.CROSS_REVISION }}',
                'path': '~/.cargo/bin/cross',
              }),
            }),
            dict({
              'env': dict({
                'CARGO_PROFILE_DEV_CODEGEN_BACKEND': 'llvm',
                'CARGO_PROFILE_RELEASE_CODEGEN_BACKEND': 'llvm',
                'RUSTFLAGS': '',
              }),
              'name': 'Install cross',
              'run': '''
                if [ -x "$HOME/.cargo/bin/cross" ]; then
                  exit 0
                fi
                cargo install cross --git https://github.com/cross-rs/cross --rev "${CROSS_REVISION}"
  
              ''',
            }),
            dict({
              'name': 'Cache cargo registry',
              'uses': 'actions/cache@<sha>',
              'with': dict({
                'key': "${{ runner.os }}-cargo-${{ matrix.target }}-${{ hashFiles('**/Cargo.lock') }}",
                'path': '''
                  ~/.cargo/registry
                  ~/.cargo/git
  
                ''',
                'restore-keys': '''
                  ${{ runner.os }}-cargo-${{ matrix.target }}-
  
                ''',
              }),
            }),
            dict({
              'env': dict({
                'CARGO_PROFILE_DEV_CODEGEN_BACKEND': 'llvm',
                'CARGO_PROFILE_RELEASE_CODEGEN_BACKEND': 'llvm',
              }),
              'name': 'Build release binary',
              'run': 'cross +nightly-2026-08-27 build --release --target ${{ matrix.target }}',
            }),
            dict({
              'name': 'Prepare artifact',
              'run': '''
                mkdir -p artifacts/${{ matrix.os }}-${{ matrix.arch }}
                cp target/${{ matrix.target }}/release/${{ env.BIN_NAME }}${{ matrix.ext }} \
                  artifacts/${{ matrix.os }}-${{ matrix.arch }}/${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }}
                cd artifacts/${{ matrix.os }}-${{ matrix.arch }}
                sha256sum ${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }} > \
                  ${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }}.sha256
  
              ''',
            }),
            dict({
              'name': 'Upload release artifact',
              'uses': 'actions/upload-artifact@<sha>',
              'with': dict({
                'name': '${{ env.BIN_NAME }}-${{ matrix.os }}-${{ matrix.arch }}',
                'path': 'artifacts/${{ matrix.os }}-${{ matrix.arch }}',
              }),
            }),
          ]),
          'strategy': dict({
            'matrix': dict({
              'include': list([
                dict({
                  'arch': 'x86_64',
                  'ext': '',
                  'os': 'linux',
                  'target': 'x86_64-unknown-linux-gnu',
                }),
                dict({
                  'arch': 'aarch64',
                  'ext': '',
                  'os': 'linux',
                  'target': 'aarch64-unknown-linux-gnu',
                }),
                dict({
                  'arch': 'x86_64',
                  'ext': '.exe',
                  'os': 'windows',
                  'target': 'x86_64-pc-windows-gnu',
                }),
                dict({
                  'arch': 'x86_64',
                  'ext': '',
                  'os': 'macos',
                  'target': 'x86_64-apple-darwin',
                }),
                dict({
                  'arch': 'aarch64',
                  'ext': '',
                  'os': 'macos',
                  'target': 'aarch64-apple-darwin',
                }),
                dict({
                  'arch': 'x86_64',
                  'ext': '',
                  'os': 'freebsd',
                  'target': 'x86_64-unknown-freebsd',
                }),
              ]),
            }),
          }),
          'timeout-minutes': 60,
        }),
        'release': dict({
          'needs': 'build',
          'permissions': dict({
            'contents': 'write',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/download-artifact@<sha>',
              'with': dict({
                'path': 'artifacts',
              }),
            }),
            dict({
              'env': dict({
                'GITHUB_TOKEN': '${{ secrets.GITHUB_TOKEN }}',
              }),
              'uses': 'softprops/action-gh-release@<sha>',
              'with': dict({
                'files': '''
                  artifacts/*/*
  
                ''',
                'generate_release_notes': True,
              }),
            }),
          ]),
          'timeout-minutes': 30,
        }),
      }),
      'name': 'Release Binary',
      True: dict({
        'push': dict({
          'tags': list([
            'v*.*.*',
          ]),
        }),
      }),
    }),
  })
# ---
