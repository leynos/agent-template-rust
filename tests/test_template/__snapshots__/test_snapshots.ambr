# serializer version: 1
# name: test_generated_structured_file_snapshots
  dict({
    'act_workflow': dict({
      'jobs': dict({
        'act-validation': dict({
          'env': dict({
            'ACT_VERSION': 'v0.2.80',
            'CARGO_TERM_COLOR': 'always',
          }),
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
            }),
            dict({
              'name': 'Install act',
              'run': '''
                curl -fsSL "https://github.com/nektos/act/releases/download/${ACT_VERSION}/act_Linux_x86_64.tar.gz" |
                  sudo tar -xz -C /usr/local/bin act
  
              ''',
            }),
            dict({
              'name': 'Check Docker runtime',
              'run': 'docker info',
            }),
            dict({
              'name': 'Run tests with act validation',
              'run': 'make test WITH_ACT=1',
            }),
          ]),
        }),
      }),
      'name': 'Act Validation',
      'on': dict({
        'pull_request': dict({
          'types': list([
            'opened',
            'synchronize',
            'reopened',
          ]),
        }),
        'workflow_dispatch': None,
      }),
    }),
    'audit_workflow': dict({
      'jobs': dict({
        'audit': dict({
          'env': dict({
            'CARGO_TERM_COLOR': 'always',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'name': 'Install cargo-audit',
              'run': 'cargo binstall --no-confirm cargo-audit',
            }),
            dict({
              'name': 'Setup Python for audit manifest extraction',
              'uses': 'actions/setup-python@<sha>',
              'with': dict({
                'python-version': '3.x',
              }),
            }),
            dict({
              'name': 'Audit dependencies',
              'run': 'make audit',
            }),
          ]),
          'timeout-minutes': 30,
        }),
      }),
      'name': 'Scheduled dependency audit',
      'on': dict({
        'schedule': list([
          dict({
            'cron': '41 6 * * 1',
          }),
        ]),
        'workflow_dispatch': None,
      }),
      'permissions': dict({
        'contents': 'read',
      }),
    }),
    'cargo_config': '''
      # Repository-wide Cargo defaults for the development build standard.
      #
      # The parallel `rustc` frontend and, on Linux, the `mold` linker are the
      # defaults for every development, test, lint and typecheck build. Cargo
      # discovers this file, so a bare `cargo build` gets them too.
      #
      # Cargo selects one `rustflags` source rather than merging sources: a matching
      # `[target.*]` table replaces `[build] rustflags`, and an assigned `RUSTFLAGS`
      # environment variable replaces both. Every flag is therefore repeated in each
      # source here, and the Makefile composes the same flags into the `RUSTFLAGS`
      # its recipes set. Coverage, the Whitaker lint route and the release recipe
      # assign `RUSTFLAGS` without the development flags on purpose.
      #
      # Cranelift is selected through rustc's nightly flag rather than the unstable
      # Cargo `[profile.dev] codegen-backend` key. Stable Cargo cannot parse that
      # key, and a release build must parse this file; the rustflags route lets the
      # stable release recipe clear `RUSTFLAGS` and drop the nightly flags instead.
      [build]
      rustflags = ["-Zpolonius=next", "-Zthreads=8", "-Zcodegen-backend=cranelift"]
      rustdocflags = ["-Zpolonius=next"]
      
      # `mold` ships for Linux only, and the `cfg` table matches every Linux target
      # rather than the requested development triple alone. The linker selection and
      # the mold flag therefore live together: a target that receives the flag also
      # selects the driver that accepts it. GCC before 12.1 rejects `-fuse-ld=mold`,
      # so leaving the platform driver in place would fail a bare `cargo build` on a
      # native AArch64 Linux host. Other targets, macOS and Windows included, keep
      # their platform linker.
      #
      # The `cfg` table replaces `[build] rustflags` whenever it matches, so it must
      # repeat every development flag as well as the linker selection.
      [target.'cfg(target_os = "linux")']
      linker = "clang"
      rustflags = ["-Zpolonius=next", "-Zthreads=8", "-Zcodegen-backend=cranelift", "-Clink-arg=-fuse-ld=mold"]
      
      # Cargo coordinates metadata output itself on dated nightlies from 2026-07-31.
      # A generated project pinning an older nightly omits this table. Never use raw
      # rustc metadata flags; they broke build scripts.
      [unstable]
      embed-metadata = false
  
    ''',
    'ci_workflow': dict({
      'jobs': dict({
        'build-test': dict({
          'env': dict({
            'BUILD_PROFILE': 'debug',
            'CARGO_TERM_COLOR': 'always',
          }),
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'install-clang-lld': 'true',
                'install-mold': 'true',
                'rustflags': '-Zpolonius=next',
              }),
            }),
            dict({
              'name': 'Log Rust compiler configuration',
              'run': '''
                rustc --version
                printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
              ''',
            }),
            dict({
              'name': 'Install rust-analyzer',
              'run': 'rustup component add rust-analyzer',
            }),
            dict({
              'name': 'Install mdtablefix',
              'uses': 'leynos/shared-actions/.github/actions/install-mdtablefix@<sha>',
              'with': dict({
                'version': '0.6.1',
              }),
            }),
            dict({
              'name': 'Format',
              'run': 'make check-fmt',
            }),
            dict({
              'name': 'Markdown lint',
              'uses': 'DavidAnson/markdownlint-cli2-action@<sha>',
              'with': dict({
                'globs': '''
                  **/*.md
                  !**/target/**
                  !**/dist/**
  
                ''',
              }),
            }),
            dict({
              'name': 'Setup uv',
              'uses': 'astral-sh/setup-uv@<sha>',
            }),
            dict({
              'name': 'Install the YAML lint tools',
              'uses': 'leynos/shared-actions/.github/actions/install-yaml-lint@<sha>',
            }),
            dict({
              'name': 'Check the CV-005 workflow contracts',
              'run': 'make test-workflow-contracts',
            }),
            dict({
              'name': 'Check spelling',
              'run': 'make spelling',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'name': 'Install test runner',
              'run': 'cargo binstall --no-confirm --locked cargo-nextest',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'if': "github.actor != 'dependabot[bot]'",
              'name': 'Install cargo-audit',
              'run': 'cargo binstall --no-confirm cargo-audit',
            }),
            dict({
              'if': "github.actor != 'dependabot[bot]'",
              'name': 'Setup Python for audit manifest extraction',
              'uses': 'actions/setup-python@<sha>',
              'with': dict({
                'python-version': '3.x',
              }),
            }),
            dict({
              'name': 'Install Whitaker',
              'uses': 'leynos/shared-actions/.github/actions/install-whitaker@<sha>',
              'with': dict({
                'cranelift': 'true',
              }),
            }),
            dict({
              'if': "github.actor != 'dependabot[bot]'",
              'name': 'Audit dependencies',
              'run': 'make audit',
            }),
            dict({
              'name': 'Lint',
              'run': 'make lint',
            }),
            dict({
              'name': 'Run compile-time UI tests',
              'run': 'make test-ui',
            }),
            dict({
              'name': 'Exclude compile-time targets from the coverage build',
              'run': 'scripts/exclude-ui-targets.sh',
            }),
            dict({
              'name': 'Log coverage linker configuration',
              'run': '''
                echo "Coverage linker: clang"
                echo "Coverage RUSTFLAGS: -Zpolonius=next -C link-arg=-fuse-ld=lld"
                echo "Coverage CFLAGS: -fuse-ld=lld"
                echo "Coverage LDFLAGS: -fuse-ld=lld"
  
              ''',
            }),
            dict({
              'env': dict({
                'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER': 'clang',
                'CFLAGS': '-fuse-ld=lld',
                'LDFLAGS': '-fuse-ld=lld',
                'RUSTFLAGS': '-Zpolonius=next -C link-arg=-fuse-ld=lld',
              }),
              'name': 'Test and Measure Coverage',
              'uses': 'leynos/shared-actions/.github/actions/generate-coverage@<sha>',
              'with': dict({
                'format': 'lcov',
                'output-path': 'lcov.info',
                'publish-artefact': 'false',
                'with-ratchet': 'true',
              }),
            }),
          ]),
        }),
      }),
      'name': 'CI',
      'on': dict({
        'pull_request': dict({
          'types': list([
            'opened',
            'synchronize',
            'reopened',
          ]),
        }),
        'workflow_dispatch': None,
      }),
    }),
    'coverage_main_workflow': dict({
      'concurrency': dict({
        'cancel-in-progress': False,
        'group': 'coverage-main-${{ github.ref }}',
      }),
      'jobs': dict({
        'coverage-upload': dict({
          'env': dict({
            'BUILD_PROFILE': 'debug',
            'CARGO_TERM_COLOR': 'always',
          }),
          'environment': 'codescene',
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'name': 'Setup Rust',
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'install-clang-lld': 'true',
                'install-mold': 'true',
                'rustflags': '-Zpolonius=next',
              }),
            }),
            dict({
              'name': 'Log Rust compiler configuration',
              'run': '''
                rustc --version
                printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
              ''',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'name': 'Install test runner',
              'run': 'cargo binstall --no-confirm --locked cargo-nextest',
            }),
            dict({
              'name': 'Run compile-time UI tests',
              'run': 'make test-ui',
            }),
            dict({
              'name': 'Exclude compile-time targets from the coverage build',
              'run': 'scripts/exclude-ui-targets.sh',
            }),
            dict({
              'name': 'Log coverage linker configuration',
              'run': '''
                echo "Coverage linker: clang"
                echo "Coverage RUSTFLAGS: -Zpolonius=next -C link-arg=-fuse-ld=lld"
                echo "Coverage CFLAGS: -fuse-ld=lld"
                echo "Coverage LDFLAGS: -fuse-ld=lld"
  
              ''',
            }),
            dict({
              'env': dict({
                'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER': 'clang',
                'CFLAGS': '-fuse-ld=lld',
                'LDFLAGS': '-fuse-ld=lld',
                'RUSTFLAGS': '-Zpolonius=next -C link-arg=-fuse-ld=lld',
              }),
              'name': 'Test and Measure Coverage',
              'uses': 'leynos/shared-actions/.github/actions/generate-coverage@<sha>',
              'with': dict({
                'format': 'lcov',
                'output-path': 'lcov.info',
                'publish-baseline': "${{ github.ref == 'refs/heads/main' && 'always' || 'auto' }}",
                'with-ratchet': 'true',
              }),
            }),
            dict({
              'id': 'codescene_token',
              'name': 'Check CodeScene token availability',
              'run': 'echo "available=${{ secrets.CS_ACCESS_TOKEN != \'\' }}" >> "$GITHUB_OUTPUT"',
            }),
            dict({
              'if': "steps.codescene_token.outputs.available == 'true' && github.ref == 'refs/heads/main'",
              'name': 'Upload coverage data to CodeScene',
              'uses': 'leynos/shared-actions/.github/actions/upload-codescene-coverage@<sha>',
              'with': dict({
                'access-token': '${{ secrets.CS_ACCESS_TOKEN }}',
                'format': 'lcov',
                'mode': 'upload',
              }),
            }),
          ]),
        }),
      }),
      'name': 'Coverage (main)',
      'on': dict({
        'push': dict({
          'branches': list([
            'main',
          ]),
        }),
        'workflow_dispatch': None,
      }),
    }),
    'cv005_config': dict({
      'repository': 'example/snapshot_example',
      'selection': dict({
        'format': 'lcov',
        'output-path': 'lcov.info',
        'with-ratchet': 'true',
      }),
    }),
    'makefile': '''
      .PHONY: help all clean test test-ui build release coverage lint lint-actions lint-shell lint-yaml fmt check-fmt markdownlint spelling test-workflow-contracts nixie audit rust-audit install-build-tools install-cranelift check-build-tools check-rust-toolchain check-coverage-tools
      
      SHELL := bash
      
      
      TARGET ?= snapshot_example
      
      USER_WHITAKER := $(HOME)/.local/bin/whitaker
      USER_BIN_PATH := $(HOME)/.cargo/bin:$(HOME)/.local/bin:$(HOME)/.bun/bin
      CARGO ?= cargo
      BUILD_JOBS ?=
      BUILD_TOOLS_PREFIX ?= $(HOME)/.local
      BUILD_TOOLS_PATH = $(BUILD_TOOLS_PREFIX)/bin:$$PATH
      # Capability checks report what the machine has; they never install anything.
      # Each is overridable so a caller with an equivalent environment can replace it
      # without editing the target graph.
      CHECK_BUILD_TOOLS ?= PATH="$(BUILD_TOOLS_PATH)" scripts/check-build-tools.sh
      CHECK_RUST_TOOLCHAIN ?= PATH="$(BUILD_TOOLS_PATH)" scripts/check-build-tools.sh --toolchain-only
      CHECK_COVERAGE_TOOLS ?= PATH="$(BUILD_TOOLS_PATH)" scripts/check-build-tools.sh --coverage-only
      # RUSTFLAGS overrides .cargo/config.toml, so recipes that set it must re-state
      # the Polonius flag explicitly.
      POLONIUS_FLAGS ?= -Zpolonius=next
      # RUSTFLAGS inherited from the environment is appended: assigning RUSTFLAGS in
      # a recipe replaces both the environment value and the flags Cargo would read
      # from .cargo/config.toml.
      INHERITED_RUST_FLAGS := $(RUSTFLAGS)
      RUST_FLAGS ?=
      RUST_FLAGS := $(INHERITED_RUST_FLAGS) -D warnings $(RUST_FLAGS)
      DEV_LINKER_FLAGS ?= $(if $(filter Linux,$(shell uname -s)),-C link-arg=-fuse-ld=mold)
      # Development builds use Cranelift through rustc's nightly flag and run the
      # compiler frontend on eight threads. Coverage, Whitaker and release omit both:
      # instrumented coverage and release linking must keep the platform codegen.
      DEV_CODEGEN_FLAGS ?= -Zthreads=8 -Zcodegen-backend=cranelift
      DEV_RUST_FLAGS ?= $(RUST_FLAGS) $(POLONIUS_FLAGS) $(DEV_CODEGEN_FLAGS) $(DEV_LINKER_FLAGS)
      WHITAKER_RUST_FLAGS ?= $(RUST_FLAGS) $(POLONIUS_FLAGS)
      RELEASE_RUST_FLAGS ?= $(POLONIUS_FLAGS)
      RELEASE_CARGO ?= $(CARGO)
      RUSTDOC_FLAGS ?=
      RUSTDOC_FLAGS := --cfg docsrs -D warnings $(POLONIUS_FLAGS) $(RUSTDOC_FLAGS)
      CARGO_FLAGS ?= --all-targets --all-features
      CLIPPY_FLAGS ?= $(CARGO_FLAGS) -- $(RUST_FLAGS)
      TEST_FLAGS ?= $(CARGO_FLAGS)
      # Selecting the runner must not provision anything: rustup installs a missing
      # pinned toolchain on demand, so the probe disables that, exactly as the
      # read-only capability checks do. Only the explicit installer targets install.
      TEST_CMD := $(if $(shell RUSTUP_AUTO_INSTALL=0 $(CARGO) nextest --version 2>/dev/null),nextest run,test)
      # `cargo test` has no profiles. Under nextest, the `ui` profile carries the
      # serialized `nested-cargo` group and the longer compile-test timeout.
      UI_TEST_CMD := $(if $(filter nextest run,$(TEST_CMD)),$(TEST_CMD) --profile ui,$(TEST_CMD))
      # The UI lane selects its targets by name, so `--all-targets` would reintroduce
      # the ordinary tests it is separated from. It still needs the same feature
      # selection as `make test`: a contract fixture may use a non-default feature.
      UI_TEST_FLAGS ?= --all-features
      COVERAGE_LINKER_FLAGS ?= -fuse-ld=lld
      COVERAGE_RUST_FLAGS ?= $(RUST_FLAGS) $(POLONIUS_FLAGS) -C link-arg=$(COVERAGE_LINKER_FLAGS)
      MDLINT ?= markdownlint-cli2
      # `make fmt` and `make check-fmt` call mdtablefix directly. `--git` selects the
      # Markdown files Git tracks and `--include-untracked` adds the untracked files
      # Git does not ignore, so a new document is formatted before it is staged.
      # Both modes need mdtablefix 0.6.0 or later; CI pins the version at the
      # install-mdtablefix step.
      MDTABLEFIX ?= mdtablefix
      MDTABLEFIX_SELECT = --git --include-untracked
      MDTABLEFIX_RULES = --wrap --renumber --breaks --ellipsis --fences
      # Compile-time contract tests are named `tests/compile_*.rs`. The convention
      # lets the explicit UI lane select them without a declared manifest, and an
      # empty selection is an intentional no-op rather than a failure.
      UI_TEST_TARGETS := $(patsubst tests/%.rs,%,$(wildcard tests/compile_*.rs))
      # `make test` owns every test except the compile-time contract targets: those
      # build nested Cargo projects, so `test-ui` runs them alone with the serialized
      # profile. nextest rejects a binary filter that names no binary, so the
      # exclusion is added only when a target was discovered; the `cargo test`
      # fallback cannot express it and runs them as ordinary tests.
      TEST_UI_EXCLUDE := $(if $(filter nextest run,$(TEST_CMD)),$(if $(strip $(UI_TEST_TARGETS)),-E 'not binary(compile_*)'))
      # Coverage makes the same split through the same filter. The shared CI
      # coverage action exposes no test filter and always runs workspace nextest, so
      # its caller deselects the targets in the project's nextest profile with
      # `scripts/exclude-ui-targets.sh`; the targets stay in the crate.
      COVERAGE_NEXTEST := $(if $(filter nextest run,$(TEST_CMD)),nextest)
      NIXIE ?= nixie
      # YAML, workflow and shell lint tools are provisioned by the shared
      # install-yaml-lint action in CI and may come from any package manager
      # locally. Each target names the missing tool and how to install it.
      YAMLLINT ?= yamllint
      ACTIONLINT ?= actionlint
      SHELLCHECK ?= shellcheck
      TYPOS_CONFIG_BUILDER_VERSION ?= v0.1.3
      TYPOS_CONFIG_BUILDER = uv tool run --from \
      \t"git+https://github.com/leynos/typos-config-builder.git@$(TYPOS_CONFIG_BUILDER_VERSION)" \
      \ttypos-config-builder
      WHITAKER ?= $(or $(shell command -v whitaker 2>/dev/null),$(wildcard $(USER_WHITAKER)),whitaker)
      UV ?= uv
      # The shared CV-005 checker is pinned by one revision, so a rule fix is a pin
      # bump and the generated project never carries its own copy of the rules.
      CV005_CONTRACTS_REF ?= 38905b4b2caec5b049438e6dc3f3f6b36c04d2df
      CV005_CONTRACTS = $(UV) tool run --python 3.13 \
      \t--from 'git+https://github.com/leynos/shared-actions@$(CV005_CONTRACTS_REF)\#subdirectory=packages/cv005-contracts' \
      \tcv005-contracts
      
      build: target/debug/$(TARGET) ## Build debug binary
      release: check-rust-toolchain target/release/$(TARGET) ## Build release binary
      
      all: check-fmt lint test test-ui test-workflow-contracts ## Perform a comprehensive check of code
      \t+$(MAKE) spelling
      
      install-build-tools: ## Install the pinned Rust toolchain and mold linker
      \tBUILD_TOOLS_PREFIX="$(BUILD_TOOLS_PREFIX)" scripts/install-build-tools.sh
      
      install-cranelift: ## Install the Cranelift backend for the pinned toolchain
      \tscripts/install-build-tools.sh --cranelift-only
      
      check-build-tools: ## Check the pinned toolchain, clang and mold
      \t@$(CHECK_BUILD_TOOLS)
      
      check-rust-toolchain: ## Check the pinned Rust toolchain and components
      \t@$(CHECK_RUST_TOOLCHAIN)
      
      check-coverage-tools: ## Check the clang and lld linkers used for coverage
      \t@$(CHECK_COVERAGE_TOOLS)
      
      clean: ## Remove build artefacts
      \t$(CARGO) clean
      \trm -f .typos-oxendict-base.json .typos-oxendict-base.toml
      
      test: check-build-tools
      test: export RUSTFLAGS := $(DEV_RUST_FLAGS)
      test: ## Run tests with warnings treated as errors
      \tPATH="$(BUILD_TOOLS_PATH)" $(CARGO) $(TEST_CMD) $(TEST_FLAGS) $(TEST_UI_EXCLUDE) $(BUILD_JOBS)
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTDOCFLAGS="$(RUSTDOC_FLAGS)" $(CARGO) test --doc --workspace --all-features
      
      # Compile-time contract tests build nested Cargo projects, so the lane runs
      # them on their own instead of inside the instrumented coverage build. It is
      # part of `all` for exactly that reason: excluding the targets from `test`
      # would otherwise drop them from the comprehensive local gate. A project
      # without `tests/compile_*.rs` reports an intentional no-op.
      test-ui: check-build-tools ## Run compile-time contract tests
      \t@set -euo pipefail; \
      \tif [ -z "$(strip $(UI_TEST_TARGETS))" ]; then \
      \t  echo "No compile-time UI test targets (tests/compile_*.rs); nothing to run."; \
      \t  exit 0; \
      \tfi; \
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTFLAGS="$(DEV_RUST_FLAGS)" $(CARGO) $(UI_TEST_CMD) $(UI_TEST_FLAGS) $(addprefix --test ,$(UI_TEST_TARGETS))
      
      target/debug/$(TARGET): check-build-tools
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTFLAGS="$(DEV_RUST_FLAGS)" $(CARGO) build $(BUILD_JOBS) --bin $(TARGET)
      
      target/release/$(TARGET):
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTFLAGS="$(RELEASE_RUST_FLAGS)" $(RELEASE_CARGO) build $(BUILD_JOBS) --release --bin $(TARGET)
      
      coverage: check-coverage-tools ## Generate lcov coverage with lld for llvm-tools compatibility
      \t@echo "coverage linker flags: $(COVERAGE_LINKER_FLAGS)"
      \tCARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang \
      \t\tRUSTFLAGS="$(COVERAGE_RUST_FLAGS)" \
      \t\tCFLAGS="$(COVERAGE_LINKER_FLAGS)" \
      \t\tLDFLAGS="$(COVERAGE_LINKER_FLAGS)" \
      \t\t$(CARGO) llvm-cov $(COVERAGE_NEXTEST) --lcov --output-path lcov.info $(TEST_FLAGS) $(TEST_UI_EXCLUDE)
      
      # `git ls-files -z` enumerates the YAML this project owns. The patterns end in
      # `.yml` or `.yaml`, so Copier/Jinja sources are never handed to yamllint as
      # though they were YAML. `xargs -0 -r` preserves paths with spaces and runs
      # nothing when no file matches. `pipefail` keeps a failed enumeration from
      # reading as a clean run: without it the pipeline returns xargs's status and the
      # target reports success having linted nothing.
      lint-yaml: ## Lint every tracked YAML file strictly
      \t@if ! command -v $(YAMLLINT) >/dev/null 2>&1; then \
      \t  echo "yamllint is required to lint YAML; install it with: uv tool install yamllint" >&2; \
      \t  exit 1; \
      \tfi
      \t@set -o pipefail; git ls-files -z '*.yml' '*.yaml' | xargs -0 -r $(YAMLLINT) --strict --
      
      # actionlint inspects the workflow files GitHub actually executes and runs
      # ShellCheck over every `run:` script it finds.
      lint-actions: ## Lint GitHub Actions workflows and their shell scripts
      \t@if ! command -v $(ACTIONLINT) >/dev/null 2>&1; then \
      \t  echo "actionlint is required to lint workflows; install it from https://github.com/rhysd/actionlint" >&2; \
      \t  exit 1; \
      \tfi
      \t@if ! command -v $(SHELLCHECK) >/dev/null 2>&1; then \
      \t  echo "shellcheck is required by actionlint; install it using your OS package manager" >&2; \
      \t  exit 1; \
      \tfi
      \t@$(ACTIONLINT) -shellcheck=$(SHELLCHECK)
      
      lint-shell: ## Lint tracked shell scripts
      \t@if ! command -v $(SHELLCHECK) >/dev/null 2>&1; then \
      \t  echo "shellcheck is required to lint shell scripts; install it using your OS package manager" >&2; \
      \t  exit 1; \
      \tfi
      \t@set -o pipefail; git ls-files -z '*.sh' | xargs -0 -r $(SHELLCHECK)
      
      lint: check-build-tools lint-yaml lint-actions lint-shell ## Run Clippy with warnings denied
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTDOCFLAGS="$(RUSTDOC_FLAGS)" RUSTFLAGS="$(DEV_RUST_FLAGS)" $(CARGO) doc --no-deps
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTFLAGS="$(DEV_RUST_FLAGS)" $(CARGO) clippy $(CLIPPY_FLAGS)
      \t@echo "Whitaker binary: $(WHITAKER)"
      \tPATH="$(USER_BIN_PATH):$(PATH)" RUSTFLAGS="$(WHITAKER_RUST_FLAGS)" $(WHITAKER) --all -- $(CARGO_FLAGS)
      
      typecheck: check-build-tools ## Type-check without building
      \tPATH="$(BUILD_TOOLS_PATH)" RUSTFLAGS="$(DEV_RUST_FLAGS)" $(CARGO) check $(CARGO_FLAGS)
      
      fmt: check-rust-toolchain ## Format Rust and Markdown sources
      \t$(CARGO) fmt --all
      \t$(MDTABLEFIX) --in-place $(MDTABLEFIX_SELECT) $(MDTABLEFIX_RULES)
      
      check-fmt: check-rust-toolchain ## Verify formatting
      \t$(CARGO) fmt --all -- --check
      \t$(MDTABLEFIX) --check $(MDTABLEFIX_SELECT) $(MDTABLEFIX_RULES)
      
      markdownlint: ## Lint Markdown files
      \t$(MDLINT) '**/*.md'
      \t+$(MAKE) spelling
      spelling: ## Enforce en-GB-oxendict spelling in Markdown prose
      \t@if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
      \t\techo "make spelling needs a Git repository: the gate enumerates tracked files with git ls-files. Run: git init && git add -A" >&2; \
      \t\texit 1; \
      \tfi
      \t@if [ -z "$$(git ls-files)" ]; then \
      \t\techo "make spelling found no tracked files: the gate enumerates tracked files with git ls-files. Run: git add -A" >&2; \
      \t\texit 1; \
      \tfi
      \t$(TYPOS_CONFIG_BUILDER) gate --repository .
      
      test-workflow-contracts: ## Check the shared CV-005 workflow contracts
      \t$(CV005_CONTRACTS) check --repository .
      
      nixie: ## Validate Mermaid diagrams
      \t$(NIXIE) --no-sandbox
      
      audit: rust-audit ## Audit dependencies for known vulnerabilities
      
      rust-audit: ## Audit the Rust workspace for known vulnerabilities
      \tset -eo pipefail; \
      \tmanifest_list=$$(mktemp); \
      \ttrap 'rm -f "$$manifest_list"' EXIT; \
      \tprintf "Audit metadata phase: deriving workspace manifests\n"; \
      \t$(CARGO) metadata --no-deps --format-version 1 | python3 -c 'import json, sys; metadata = json.load(sys.stdin); members = set(metadata["workspace_members"]); print(metadata["workspace_root"]); [print(package["manifest_path"]) for package in metadata["packages"] if package["id"] in members]' > "$$manifest_list"; \
      \tworkspace_root=$$(sed -n '1p' "$$manifest_list"); \
      \taudit_flags=(); \
      \tfor advisory in $$CARGO_AUDIT_IGNORES; do \
      \t\taudit_flags+=(--ignore "$$advisory"); \
      \tdone; \
      \tprintf "Auditing Rust workspace %s\n" "$$workspace_root"; \
      \tsed -n '2,$$p' "$$manifest_list" | while IFS= read -r manifest; do \
      \t\tmanifest_dir=$$(dirname "$$manifest"); \
      \t\tprintf "Workspace Rust manifest %s\n" "$$manifest_dir/Cargo.toml"; \
      \tdone; \
      \tprintf "Audit execution phase: running cargo audit\n"; \
      \tprintf "Audit failures may indicate RustSec advisories, cargo metadata errors, or documented ignores that need CARGO_AUDIT_IGNORES entries.\n"; \
      \t(cd "$$workspace_root" && $(CARGO) audit "$${audit_flags[@]}")
      
      help: ## Show available targets
      \t@grep -E '^[a-zA-Z_-]+:.*?##' $(MAKEFILE_LIST) | \
      \tawk 'BEGIN {FS=":"; printf "Available targets:\n"} {printf "  %-20s %s\n", $$1, $$2}'
  
    ''',
    'mutation_workflow': dict({
      'concurrency': dict({
        'cancel-in-progress': False,
        'group': 'mutation-testing-${{ github.ref }}',
      }),
      'jobs': dict({
        'mutation': dict({
          'permissions': dict({
            'contents': 'read',
            'id-token': 'write',
          }),
          'uses': 'leynos/shared-actions/.github/workflows/mutation-cargo.yml@<sha>',
          'with': dict({
            'extra-args': '--all-features',
            'install-clang-lld': 'true',
            'install-mold': 'true',
          }),
        }),
      }),
      'name': 'Mutation testing',
      'on': dict({
        'schedule': list([
          dict({
            'cron': '15 9 * * *',
          }),
        ]),
        'workflow_dispatch': None,
      }),
      'permissions': dict({
      }),
    }),
    'release_workflow': dict({
      'env': dict({
        'BIN_NAME': 'snapshot_example',
        'CROSS_REVISION': '88f49ff79e777bef6d3564531636ee4d3cc2f8d2',
      }),
      'jobs': dict({
        'build': dict({
          'permissions': dict({
            'contents': 'read',
          }),
          'runs-on': '${{ matrix.runner }}',
          'steps': list([
            dict({
              'uses': 'actions/checkout@<sha>',
              'with': dict({
                'persist-credentials': False,
              }),
            }),
            dict({
              'uses': 'leynos/shared-actions/.github/actions/setup-rust@<sha>',
              'with': dict({
                'expect-cache': 'any',
                'rustflags': '-Zpolonius=next',
                'toolchain': '',
                'use-sccache': 'false',
              }),
            }),
            dict({
              'name': 'Log Rust compiler configuration',
              'run': '''
                rustc --version
                printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
              ''',
            }),
            dict({
              'id': 'cache-cross',
              'if': "matrix.builder == 'cross'",
              'name': 'Cache cross binary',
              'uses': 'actions/cache@<sha>',
              'with': dict({
                'key': 'cross-${{ env.CROSS_REVISION }}',
                'path': '~/.cargo/bin/cross',
              }),
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '',
              }),
              'if': "matrix.builder == 'cross'",
              'name': 'Install cross',
              'run': '''
                if [ -x "$HOME/.cargo/bin/cross" ]; then
                  exit 0
                fi
                cargo install cross --git https://github.com/cross-rs/cross --rev "${CROSS_REVISION}"
  
              ''',
            }),
            dict({
              'name': 'Cache cargo registry',
              'uses': 'actions/cache@<sha>',
              'with': dict({
                'key': "${{ runner.os }}-cargo-${{ matrix.target }}-${{ hashFiles('**/Cargo.lock') }}",
                'path': '''
                  ~/.cargo/registry
                  ~/.cargo/git
  
                ''',
                'restore-keys': '''
                  ${{ runner.os }}-cargo-${{ matrix.target }}-
  
                ''',
              }),
            }),
            dict({
              'if': "matrix.builder == 'cross' && contains(matrix.target, 'linux')",
              'name': 'Select the cross linker',
              'run': '''
                set -euo pipefail
                target_key=$(printf '%s' "${{ matrix.target }}" | tr 'a-z-' 'A-Z_')
                linker=cc
                case "${{ matrix.target }}" in
                  aarch64-*) linker=aarch64-linux-gnu-gcc ;;
                esac
                printf 'CARGO_TARGET_%s_LINKER=%s\n' "$target_key" "$linker" >> "$GITHUB_ENV"
  
              ''',
            }),
            dict({
              'if': "matrix.builder == 'cargo'",
              'name': 'Add native target',
              'run': 'rustup target add "${{ matrix.target }}"',
            }),
            dict({
              'env': dict({
                'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER': 'cc',
                'RUSTFLAGS': '-Zpolonius=next',
              }),
              'if': "matrix.builder == 'cross'",
              'name': 'Build release binary (cross)',
              'run': 'cross build --release --target ${{ matrix.target }}',
            }),
            dict({
              'env': dict({
                'RUSTFLAGS': '-Zpolonius=next',
              }),
              'if': "matrix.builder == 'cargo'",
              'name': 'Build release binary (native)',
              'run': 'cargo build --release --target ${{ matrix.target }}',
            }),
            dict({
              'name': 'Prepare artifact',
              'run': '''
                mkdir -p artifacts/${{ matrix.os }}-${{ matrix.arch }}
                cp target/${{ matrix.target }}/release/${{ env.BIN_NAME }}${{ matrix.ext }} \
                  artifacts/${{ matrix.os }}-${{ matrix.arch }}/${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }}
                cd artifacts/${{ matrix.os }}-${{ matrix.arch }}
                shasum -a 256 ${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }} > \
                  ${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }}.sha256
  
              ''',
            }),
            dict({
              'name': 'Upload release artifact',
              'uses': 'actions/upload-artifact@<sha>',
              'with': dict({
                'name': '${{ env.BIN_NAME }}-${{ matrix.os }}-${{ matrix.arch }}',
                'path': 'artifacts/${{ matrix.os }}-${{ matrix.arch }}',
              }),
            }),
          ]),
          'strategy': dict({
            'fail-fast': False,
            'matrix': dict({
              'include': list([
                dict({
                  'arch': 'x86_64',
                  'builder': 'cross',
                  'ext': '',
                  'os': 'linux',
                  'runner': 'ubuntu-latest',
                  'target': 'x86_64-unknown-linux-gnu',
                }),
                dict({
                  'arch': 'aarch64',
                  'builder': 'cross',
                  'ext': '',
                  'os': 'linux',
                  'runner': 'ubuntu-latest',
                  'target': 'aarch64-unknown-linux-gnu',
                }),
                dict({
                  'arch': 'x86_64',
                  'builder': 'cross',
                  'ext': '.exe',
                  'os': 'windows',
                  'runner': 'ubuntu-latest',
                  'target': 'x86_64-pc-windows-gnu',
                }),
                dict({
                  'arch': 'x86_64',
                  'builder': 'cargo',
                  'ext': '',
                  'os': 'macos',
                  'runner': 'macos-15-intel',
                  'target': 'x86_64-apple-darwin',
                }),
                dict({
                  'arch': 'aarch64',
                  'builder': 'cargo',
                  'ext': '',
                  'os': 'macos',
                  'runner': 'macos-latest',
                  'target': 'aarch64-apple-darwin',
                }),
                dict({
                  'arch': 'x86_64',
                  'builder': 'cross',
                  'ext': '',
                  'os': 'freebsd',
                  'runner': 'ubuntu-latest',
                  'target': 'x86_64-unknown-freebsd',
                }),
              ]),
            }),
          }),
          'timeout-minutes': 60,
        }),
        'release': dict({
          'if': "github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs['dry-run'] == false && startsWith(github.ref, 'refs/tags/'))",
          'needs': 'build',
          'permissions': dict({
            'contents': 'write',
          }),
          'runs-on': 'ubuntu-latest',
          'steps': list([
            dict({
              'uses': 'actions/download-artifact@<sha>',
              'with': dict({
                'path': 'artifacts',
              }),
            }),
            dict({
              'env': dict({
                'GITHUB_TOKEN': '${{ secrets.GITHUB_TOKEN }}',
              }),
              'uses': 'softprops/action-gh-release@<sha>',
              'with': dict({
                'files': '''
                  artifacts/*/*
  
                ''',
                'generate_release_notes': True,
              }),
            }),
          ]),
          'timeout-minutes': 30,
        }),
      }),
      'name': 'Release Binary',
      True: dict({
        'push': dict({
          'tags': list([
            'v*.*.*',
          ]),
        }),
        'workflow_dispatch': dict({
          'inputs': dict({
            'dry-run': dict({
              'default': True,
              'description': "Build every matrix leg and upload the artefacts, but create no release. Set to false on a tag ref to publish that tag's release.",
              'type': 'boolean',
            }),
          }),
        }),
      }),
    }),
  })
# ---
