{% if enable_polonius -%}
# This project enables the nightly-only Polonius alpha borrow checker. Keep the
# dated pin reproducible and review docs/polonius.md before changing it.
{% endif -%}
[toolchain]
channel = "nightly-{{ rust_nightly_date }}"
components = [
  "clippy",
  "llvm-tools-preview",
  "rustc-codegen-cranelift-preview",
  "rustfmt",
]
