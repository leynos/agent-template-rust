{%- set release_toolchain = '' if enable_polonius else 'stable' -%}
{%- set release_cargo_toolchain = '' if enable_polonius else '+stable ' -%}
{%- set release_rustup_toolchain = '' if enable_polonius else '--toolchain stable ' -%}
{%- set release_rustflags = '-Zpolonius=next' if enable_polonius else '' -%}
{% raw -%}
name: Release Binary

# A tag push publishes that tag. A dispatch is a dry run by default: every
# matrix leg builds and uploads its artefacts, but no release is created unless
# the dispatch names a tag ref and sets dry-run to false. A branch dispatch can
# therefore never publish, even when it asks to.
on:
  push:
    tags:
      - 'v*.*.*'
  workflow_dispatch:
    inputs:
      dry-run:
        description: >-
          Build every matrix leg and upload the artefacts, but create no
          release. Set to false on a tag ref to publish that tag's release.
        type: boolean
        default: true

env:
  BIN_NAME: {% endraw %}{{ package_name }}{% raw %}
  CROSS_REVISION: 88f49ff79e777bef6d3564531636ee4d3cc2f8d2

jobs:
  build:
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    strategy:
      # A failed leg must not cancel the others: a broken macOS leg should not
      # hide whether the Linux, Windows and FreeBSD legs build at all.
      fail-fast: false
      matrix:
        include:
          - os: linux
            arch: x86_64
            target: x86_64-unknown-linux-gnu
            runner: ubuntu-latest
            builder: cross
            ext: ""
          - os: linux
            arch: aarch64
            target: aarch64-unknown-linux-gnu
            runner: ubuntu-latest
            builder: cross
            ext: ""
          - os: windows
            arch: x86_64
            target: x86_64-pc-windows-gnu
            runner: ubuntu-latest
            builder: cross
            ext: ".exe"
          - os: macos
            arch: x86_64
            target: x86_64-apple-darwin
            runner: macos-15-intel
            builder: cargo
            ext: ""
          - os: macos
            arch: aarch64
            target: aarch64-apple-darwin
            runner: macos-latest
            builder: cargo
            ext: ""
          - os: freebsd
            arch: x86_64
            target: x86_64-unknown-freebsd
            runner: ubuntu-latest
            builder: cross
            ext: ""
    steps:
      - uses: actions/checkout@900f2210b1d28bbbd0bd22d17926b9e224e8f231
        with:
          persist-credentials: false
      # A Polonius project releases on the same toolchain development uses,
      # because its source requires `-Zpolonius=next`, and `rust-toolchain.toml`
      # is that toolchain's single source of truth. The toolchain input is
      # therefore empty: setup-rust installs whatever the file pins and every
      # later command resolves through it, so a Dependabot update to the nightly
      # moves development and release together. The other nightly development
      # flags are still cleared below. Every other project releases on stable,
      # whose Cargo must parse the generated configuration.
      # sccache is disabled because a release build never saves it and cross
      # runs in a container that receives neither RUSTC_WRAPPER nor
      # SCCACHE_PATH.
      - uses: leynos/shared-actions/.github/actions/setup-rust@b804b69fa7f978cf9091b9d9bd5481d8ce58c2ea
        with:
          expect-cache: any
          use-sccache: 'false'
          toolchain: '{% endraw %}{{ release_toolchain }}{% raw %}'
          rustflags: '{% endraw %}{{ release_rustflags }}{% raw %}'
      - name: Log Rust compiler configuration
        run: |-
          rustc --version
          printf 'Base RUSTFLAGS: %s\n' "$RUSTFLAGS"
      - name: Cache cross binary
        if: matrix.builder == 'cross'
        id: cache-cross
        uses: actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae
        with:
          path: ~/.cargo/bin/cross
          key: cross-${{ env.CROSS_REVISION }}
      - name: Install cross
        if: matrix.builder == 'cross'
        env:
          # Clear repository build flags from .cargo/config.toml (the mold
          # linker and Cranelift codegen backend) before installing cross.
          RUSTFLAGS: ""
        run: |
          if [ -x "$HOME/.cargo/bin/cross" ]; then
            exit 0
          fi
          cargo install cross --git https://github.com/cross-rs/cross --rev "${CROSS_REVISION}"
      - name: Cache cargo registry
        uses: actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
          key: ${{ runner.os }}-cargo-${{ matrix.target }}-${{ hashFiles('**/Cargo.lock') }}
          restore-keys: |
            ${{ runner.os }}-cargo-${{ matrix.target }}-
      - name: Select the cross linker
        if: matrix.builder == 'cross' && contains(matrix.target, 'linux')
        # Where the generated Cargo configuration selects clang for Linux
        # targets, the cross image has gcc and no clang instead. An environment
        # value beats the config file, and cross forwards CARGO_* variables
        # into the container. The variable name carries the matrix target, so
        # it cannot be spelled as a static `env` key.
        run: |
          set -euo pipefail
          target_key=$(printf '%s' "${{ matrix.target }}" | tr 'a-z-' 'A-Z_')
          printf 'CARGO_TARGET_%s_LINKER=cc\n' "$target_key" >> "$GITHUB_ENV"
      - name: Add native target
        if: matrix.builder == 'cargo'
        run: >-
          rustup target add
          {% endraw %}{{ release_rustup_toolchain }}{% raw %}"${{ matrix.target }}"
      # cross has no Docker image for Apple targets and falls back to the host
      # toolchain, which lacks the target on a Linux runner. The macOS legs
      # therefore build natively on macOS runners.
      - name: Build release binary (cross)
        if: matrix.builder == 'cross'
        env:
          # Release artefacts carry no repository-local build flags, including
          # the nightly-only development flags in .cargo/config.toml. The one
          # exception is `-Zpolonius=next` for a Polonius project, whose source
          # needs it; it is restated here without the other development flags.
          RUSTFLAGS: '{% endraw %}{{ release_rustflags }}{% raw %}'
          # Host artefacts are built inside the container too, and the
          # generated configuration selects clang where the host is Linux. The
          # container has gcc and no clang, so the host triple uses the
          # container compiler as well.
          CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER: cc
        run: >-
          cross {% endraw %}{{ release_cargo_toolchain }}{% raw %}build --release
          --target ${{ matrix.target }}
      - name: Build release binary (native)
        if: matrix.builder == 'cargo'
        env:
          # As for the cross leg: clear the development flags but keep the
          # borrow checker a Polonius project's source requires.
          RUSTFLAGS: '{% endraw %}{{ release_rustflags }}{% raw %}'
        run: >-
          cargo {% endraw %}{{ release_cargo_toolchain }}{% raw %}build --release
          --target ${{ matrix.target }}
      - name: Prepare artifact
        run: |
          mkdir -p artifacts/${{ matrix.os }}-${{ matrix.arch }}
          cp target/${{ matrix.target }}/release/${{ env.BIN_NAME }}${{ matrix.ext }} \
            artifacts/${{ matrix.os }}-${{ matrix.arch }}/${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }}
          cd artifacts/${{ matrix.os }}-${{ matrix.arch }}
          shasum -a 256 ${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }} > \
            ${{ env.BIN_NAME }}-${{ matrix.target }}${{ matrix.ext }}.sha256
      - name: Upload release artifact
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: ${{ env.BIN_NAME }}-${{ matrix.os }}-${{ matrix.arch }}
          path: artifacts/${{ matrix.os }}-${{ matrix.arch }}

  release:
    needs: build
    # A dispatch publishes only when it names a tag ref and dry-run is false.
    # The workflow's `push` trigger is tag-only, so a push event is a release.
    if: >-
      github.event_name == 'push' ||
      (github.event_name == 'workflow_dispatch' &&
      inputs['dry-run'] == false && startsWith(github.ref, 'refs/tags/'))
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@484a0b528fb4d7bd804637ccb632e47a0e638317
        with:
          path: artifacts
      - uses: softprops/action-gh-release@403a5240f3837fa857f642062e05aad6bb3391ca
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          generate_release_notes: true
          files: |
            artifacts/*/*
{%- endraw %}
