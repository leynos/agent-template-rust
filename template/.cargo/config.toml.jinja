# Cargo selects one rustflags source; target flags replace build flags.
# Make development gates repeat these defaults when assigning RUSTFLAGS.
[unstable]
codegen-backend = true

[profile.dev]
codegen-backend = "cranelift"

[build]
rustflags = ["-Zthreads=8"{% if enable_polonius %}, "-Zpolonius=next"{% endif %}]
{% if enable_polonius -%}
rustdocflags = ["-Zpolonius=next"]
{% endif %}
{% if dev_target == 'x86_64-unknown-linux-gnu' -%}
# Only native x86_64 GNU Linux has a verified mold route.
[target.{{ dev_target }}]
linker = "scripts/native-clang-linker.sh"
rustflags = ["-Zthreads=8"{% if enable_polonius %}, "-Zpolonius=next"{% endif %}, "-C", "link-arg=-fuse-ld=mold"]
{% elif dev_target -%}
# {{ dev_target }} uses its platform linker.
{% endif -%}
